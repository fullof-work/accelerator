[Unit]
Description=Accelerator pprof listening socket

[Socket]
ListenStream=127.0.0.1:6060
FileDescriptorName=pprof
Service=cache-ctl.service
Accept=no
FlushPending=no
SocketUser=kuasar-cache
SocketGroup=kuasar-cache
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
TriggerLimitIntervalSec=2s
TriggerLimitBurst=20

[Install]
WantedBy=sockets.target
