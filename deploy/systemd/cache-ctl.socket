[Unit]
Description=Accelerator cache listening socket

[Socket]
ListenStream=/run/kuasar-accelerator/cache.sock
FileDescriptorName=cache
Service=cache-ctl.service
Accept=no
FlushPending=no
SocketUser=kuasar-cache
SocketGroup=kuasar-cache
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
TriggerLimitIntervalSec=2s
TriggerLimitBurst=20

[Install]
WantedBy=sockets.target
