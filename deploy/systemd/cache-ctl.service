[Unit]
Description=Accelerator cache service
Requires=cache-ctl.socket cache-ctl-health.socket
After=cache-ctl.socket cache-ctl-health.socket
StartLimitIntervalSec=10s
StartLimitBurst=5

[Service]
Type=exec
User=kuasar-cache
Group=kuasar-cache
StateDirectory=kuasar-accelerator-cache
StateDirectoryMode=0750
Sockets=cache-ctl.socket cache-ctl-health.socket
ExecStart=/opt/kuasar/bin/cache-ctl serve --config /etc/kuasar/cache.yaml --drain-timeout 30s
Restart=on-failure
RestartSec=1s
TimeoutStartSec=90s
TimeoutStopSec=90s
KillSignal=SIGTERM
KillMode=control-group
NoNewPrivileges=true
UMask=0007

[Install]
WantedBy=multi-user.target
